# Local Supabase CLI values (printed by `pnpm supabase:start`).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# Server-only owner allowlist. Never expose this through NEXT_PUBLIC_*.
OWNER_GOOGLE_EMAIL=owner@example.com

# Google Cloud Vision, which reads a notification card screenshot (D-120) and a
# transfer slip's amount (D-129). Server-only, and never NEXT_PUBLIC_*: a key in
# a NEXT_PUBLIC_ value is a key the page hands to anyone who loads it. Only
# app/api/v1/ocr/read/route.ts reads this. Restrict the key to the Cloud Vision
# API in the Google Cloud console. It is the same one variable both readers use,
# so adding slip capture owes no new configuration. Leave it unset and both
# readers refuse with a message; everything else in the app works, and the owner
# types the figures as they did before.
GOOGLE_VISION_KEY=replace-with-a-vision-restricted-api-key

# Statement passwords are always entered in the browser prompt and kept in
# worker memory only. Never place bank credentials or statement passwords here.
