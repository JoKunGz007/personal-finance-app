{
  "name": "Private Ledger",
  "short_name": "Ledger",
  "description": "A local-first Thai bank statement and slip ledger.",
  "start_url": "/ledger",
  "scope": "/",
  "display": "standalone",
  "background_color": "#eaf0f4",
  "theme_color": "#eaf0f4",
  "icons": [
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any maskable" }
  ],
  "share_target": {
    "action": "/share-slip",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        { "name": "slip", "accept": ["image/jpeg", "image/png", "image/webp"] }
      ]
    }
  }
}
