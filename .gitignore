# Local secrets
.env
.env.*
!.env.example

# Bytecode from the owner-run Python tool in scripts/
__pycache__/

# Private financial source documents
private-statements/

# Real transfer slips and receipts used to size the OCR work. Images, so no masking
# harness reaches them and nothing here can be made value-free — treat as raw private
# data and never commit one (docs/FIXTURE_POLICY.md).
receipts_sample/

# Owner-produced working copies, written without a password so an agent can read
# them (DECISIONS D-049, docs/FIXTURE_POLICY.md). They are still real statements,
# so they are never committed and never become fixtures.
shared-statements/

# Encrypted ledger backups. AES-256-GCM under a PBKDF2 key, so the contents are opaque —
# but it is still the whole ledger, and a repository is the wrong place for it in two
# ways: it can be pushed, and it dies with the working copy it was meant to survive.
*.plbak

# Masked structural dumps from scripts/mask-statement.mjs — value-free, but they
# describe a real document, so committing one would make every fixture written
# afterwards non-invented (DECISIONS D-035, docs/FIXTURE_POLICY.md).
masked-dumps/

# Next.js, tests, and local Supabase state
node_modules/
.pnpm-store/
.next/
.runtime/
.tmp-node-install/
*.tsbuildinfo
coverage/
playwright-report/
test-results/
.supabase/
supabase/.branches/
supabase/.temp/
recovery/supabase/.branches/
recovery/supabase/.temp/
live/supabase/.branches/
live/supabase/.temp/

# Impeccable ephemeral state; shared design artifacts remain trackable.
.impeccable/config.local.json
.impeccable/hook.cache.json
.impeccable/hook.pending.json
.impeccable/*.png
.impeccable/live/server.json
.impeccable/live/sessions/
.impeccable/live/previews/
.impeccable/live/annotations/
.impeccable/live/cache/

# Copied from node_modules at build time by scripts/copy-zxing-wasm.mjs, never committed:
# a 1.1 MB binary in git is an unreviewable surface, and copying pins it to the installed
# package version rather than to whatever was checked in.
public/zxing_reader.wasm
