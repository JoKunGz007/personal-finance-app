# Local secrets
.env
.env.*
!.env.example

# Bytecode from the owner-run Python tool in scripts/
__pycache__/

# Private financial source documents. `private-statements/inbox/` is where
# scripts/fetch-statements.mjs writes what it pulls from the mailbox, so it is inside this
# boundary by construction: real, password-protected statements that an agent may never read.
private-statements/

# Names the statement mailbox and the senders it receives from. No secret is in it — the app
# password is read from stdin, never from a file — but it names an address, and an address is
# the owner's to share rather than the repository's.
statement-mailbox.json

# Real transfer slips and receipts used to size the OCR work. Images, so no masking
# harness reaches them and nothing here can be made value-free — treat as raw private
# data and never commit one (docs/FIXTURE_POLICY.md).
receipts_sample/

# Owner-produced working copies, written without a password so an agent can read
# them (DECISIONS D-049, docs/FIXTURE_POLICY.md). They are still real statements,
# so they are never committed and never become fixtures.
shared-statements/

# Encrypted ledger backups. AES-256-GCM under a PBKDF2 key, so the contents are opaque —
# but it is still the whole ledger, and a repository is the wrong place for it in two
# ways: it can be pushed, and it dies with the working copy it was meant to survive.
*.plbak

# Masked structural dumps from scripts/mask-statement.mjs — value-free, but they
# describe a real document, so committing one would make every fixture written
# afterwards non-invented (DECISIONS D-035, docs/FIXTURE_POLICY.md).
masked-dumps/

# Next.js, tests, and local Supabase state
node_modules/
.pnpm-store/
.next/
.runtime/
.tmp-node-install/
*.tsbuildinfo
coverage/
playwright-report/
test-results/
.supabase/
supabase/.branches/
supabase/.temp/
recovery/supabase/.branches/
recovery/supabase/.temp/
live/supabase/.branches/
live/supabase/.temp/

# Impeccable ephemeral state; shared design artifacts remain trackable.
.impeccable/config.local.json
.impeccable/hook.cache.json
.impeccable/hook.pending.json
.impeccable/*.png
.impeccable/live/server.json
.impeccable/live/sessions/
.impeccable/live/previews/
.impeccable/live/annotations/
.impeccable/live/cache/

# Copied from node_modules at build time by scripts/copy-zxing-wasm.mjs, never committed:
# a 1.1 MB binary in git is an unreviewable surface, and copying pins it to the installed
# package version rather than to whatever was checked in.
public/zxing_reader.wasm

# `public/tesseract/` was here until 2026-08-18 and is gone with the local OCR engine (D-129):
# the slip reader now calls Google Cloud Vision through this app's own route, so there is no
# core, worker or Thai language data to copy. Do not re-add the ignore without re-adding the
# engine — an ignore for something absent is how a rule quietly stops meaning anything.

# Phone captures of the real ledger, dropped here by the owner for an agent to measure
# (D-049, D-187). They are real financial data in image form: readable by an agent that has
# been granted it, and never a fixture, a screenshot in a commit, or a quotation in a
# continuity doc. Ignored rather than trusted to habit, because everything else in this
# directory is committable and `git add .` would not ask.
phone_screenshots/
